# The paths of the validation glue (models/gpu/validation/), every one of them and nothing else. Copy this file
# out of the repository, set each value, and source it in the shell that runs any of the scripts:
#   cp models/gpu/validation/glue.env.example ~/glue.env && $EDITOR ~/glue.env && source ~/glue.env
# Each script checks the variables it needs and refuses to run (status 2), naming the first one unset. Every value
# is exported: the runner's GPU jobs and the pool's CPU jobs run in shells of their own.

# --- this repository, as the runs see it
export VAL_GLUE=/abs/path/to/seedvr2-research/models/gpu/validation   # this folder, absolute: the scripts call
#     each other through it and write it into the pool's job lines; status.sh and ms_status2.sh find the runner
#     and the pool by it: start them as bash $VAL_GLUE/runner.sh and bash $VAL_GLUE/ms_pool2.sh
export VAL_MODELS=/abs/path/to/seedvr2-research/models   # the models/ the GPU runs load: gpu/ck_patch.py (the
#     wrapper of every safetensors run), and dist/seedvr2x_ema_7b_fp16.safetensors (seedvr2_fp16.py's 7B: the
#     float16 reference of the smoke test's check mode)
export COLOUR_SCRIPTS=/abs/path/to/seedvr2-research/research/scripts   # colour_dump.py (in every run),
#     colour_eval.py, colour_bands.py, colour_crops.py (the scoring and the crops)
export MEAS_SCRIPTS=/abs/path/to/seedvr2-research/research/scripts   # bench.py (every run), fr_metrics.py,
#     ffv1_out.py (colour.md's MEAS_SCRIPTS: colour_eval.py reads it too)
export COLOUR_BASELINE=/abs/path/to/colour.py   # colour.md's: a copy of seedvr2x's runtime/colour.py, the
#     colour corrections colour_variants.py loads (for colour_eval.py, colour_bands.py, colour_crops.py)

# --- numz (read only)
export NUMZ_DIR=/abs/path/to/numz-checkout   # numz's SeedVR2 checkout at 4490bd1: every GPU run's working directory
export NUMZ_PY=$NUMZ_DIR/.venv/bin/python   # numz's interpreter (its torch with CUDA): runs bench.py and numz's CLI
export NUMZ_MODELS=/abs/path/to/numz-models   # numz's model directory: its own files for the runs of numz's files
#     (seedvr2_ema_7b-Q4_K_M.gguf, seedvr2_ema_3b_fp16.safetensors) and ema_vae_fp16.safetensors

# --- inputs (read only)
export MEAS_CLIPS=/abs/path/to/clips   # measurement's fr_clips.py clips, tier 1: <clip>.gt.mkv, <clip>.d1.lr.mkv,
#     <clip>.d1.bicubic.mkv for anime-clean, anime-grain, anime-dark, cartoon-bright, anime-sky, anime-bright,
#     live-vfx, live-slow
export MEAS_SHOTS=/abs/path/to/clips4k   # the 4K shots of slice B, the same three files each
export COLOUR_OUT=/abs/path/to/colour-output   # colour.md's outputs: dumps/<clip>-d1/{s42,s43,s1234,sh42,sh43}/
#     (the float16 runs: decode.pt, latents.pt, s42's ref_f32.pt), eval-b1/, eval-b2/, vmaf-b1/, vmaf-b2/,
#     bands-b2/ (their scores), sum-b2/T4-1080p.md (its table), crops-b2/, crops-b2-1080p/ (its windows)

# --- tools
export METRICS_PY=/abs/path/to/venv-metrics/bin/python   # colour.md's metrics environment: the scoring, the
#     summaries, the crops, smoke_check.py
export FFMPEG_BIN=/abs/path/to/ffmpeg/bin   # put first on PATH: ffmpeg with libvmaf (n9.0.2 here); the GPU job
#     lines carry it as is (bench.py expands variables in --env values)

# --- ours: the GPU runs' other inputs
export VAL_MODELDIR=/abs/path/to/modeldir   # the runs' --model_dir: links to our files and numz's
#     ema_vae_fp16.safetensors (VALIDATION.md, Reproduce)
export VAL_PYLIB=/abs/path/to/pylib   # comfy-kitchen 0.2.37, installed for numz's interpreter outside its venv
#     (the runs' PYTHONPATH; VALIDATION.md, Reproduce)
export VAL_DYN=/abs/path/to/phase2-dyn   # seedvr2_gguf_dyn.py's --out: its *_dyn.report.json (dynmap.py)

# --- ours: outputs and state
export VAL_DATA=/abs/path/to/big-files   # big files: gpu/ (the runs' dumps/ and out/, the pool's eval/, vmaf/,
#     masters/, bands/, diff/, fr/, tmp/, the crops' crops/) and the smoke test's dumps/smoke/, out/smoke/
export VAL_STATE=/abs/path/to/small-files   # small files: gpu/ (the runner: jobs.tsv, done/, failed/, logs/,
#     STOP, GO_PAST_0845, RUNNING), score/ (the pool: done/, failed/, running/, peak/, logs/, jobs.tsv, NMAX,
#     FR_ON, FR4_ON, STOP, labels-extra*.tsv), sum/ (the pages), runs/ and smoke/runs/ (bench.py's logs and
#     ck_patch's reports), s6/sum/ and s16/ (the pairings' default outputs), and the logs you tee
export VAL_DISK=/abs/path/to/mount-point   # the file system of VAL_DATA: the runner wants MIN_FREE_GB (60) GB
#     free on it before each job
export VAL_GPU_LOCK=/abs/path/to/gpu.lock   # flock'd around every GPU job: one at a time, shared with any other
#     user of the GPU (its directory is created when missing)
